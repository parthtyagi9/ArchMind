# Copy to backend/.env and fill in. Never commit .env.

# --- MongoDB Atlas (hackathon sandbox). Run `python -m scripts.create_indexes` once to create indexes + the vector index.
MONGODB_URI=
MONGODB_DATABASE=archmind

# --- Session security. Signs login cookies and derives the key that encrypts stored Jira/Confluence/GitHub tokens.
#     Generate: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:3000

# --- Reasoning LLM (Gemini, structured output) with automatic fallback on 503/429/404
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.6-flash

# --- Embeddings for memory (dimensions MUST match the Atlas vector index; re-run create_indexes if you change them).
#     auto = Voyage if VOYAGE_API_KEY is set, otherwise Gemini.
EMBEDDING_PROVIDER=auto
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com
# Minimum cosine similarity (Atlas score) for a memory to be retrieved. Tune per embedding model.
MEMORY_MIN_SCORE=0.80

# --- GitHub OAuth (sign in with GitHub + private repo access). Optional: without it, email/password login and public repos still work.
#     Create at https://github.com/settings/developers -> New OAuth App
#       Homepage URL:               http://localhost:3000
#       Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Jira + Confluence are connected per organization in the app: Settings -> Integrations (site URL, email, API token).
