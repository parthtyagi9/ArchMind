# Copy to backend/.env and fill in. Never commit .env.
MONGODB_URI=
MONGODB_DATABASE=recallops
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
LLM_MODEL=gemini-3.8-flash
DEMO_MODE=true
# Any long random string; signs the demo session cookie. e.g. python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
