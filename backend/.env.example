# Copy to backend/.env and fill in. Never commit .env.
MONGODB_URI=
MONGODB_DATABASE=recallops

# Embeddings: Voyage AI (voyage-4, 1024 dims). Key from dash.voyageai.com, or an Atlas-issued key with
# VOYAGE_BASE_URL=https://ai.mongodb.com
# EMBEDDING_PROVIDER=local uses offline lexical embeddings (no Voyage calls)
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024

# Agent LLM: Gemini (structured output), with automatic fallback on 503/429
GEMINI_API_KEY=
# LLM_PROVIDER=rules uses the offline deterministic planner (no Gemini calls)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.6-flash

DEMO_MODE=true
# Any long random string; signs the demo session cookie. e.g. python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
